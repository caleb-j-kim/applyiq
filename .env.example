DB_NAME=applyiq
DB_USERNAME=applyiq
DB_PASSWORD=applyiq
DB_PORT=5432

SERVER_PORT=8080

# Generate your own: openssl rand -base64 64
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRATION_MS=86400000

# Comma-separated list of origins allowed to call this API from a browser.
# In production, set this to your deployed frontend's exact origin(s), e.g.
# CORS_ALLOWED_ORIGINS=https://applyiq.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo account, auto-created on backend startup for local testing.
# Set DEMO_SEED_ENABLED=false before any real deployment.
DEMO_SEED_ENABLED=true
DEMO_EMAIL=demo@applyiq.com
DEMO_PASSWORD=demo1234

# Marketing site's "View demo dashboard" preview account — reset with a
# fixed set of sample applications/resumes on every backend startup.
# Also gated by DEMO_SEED_ENABLED above.
PREVIEW_EMAIL=caleb.kim@applyiq.com
PREVIEW_PASSWORD=demo1234

# Resume files are stored in S3, not the database. Use a separate bucket per
# environment (e.g. applyiq-resumes-dev / applyiq-resumes-prod) and an IAM user
# scoped to just that bucket (GetObject/PutObject/DeleteObject).
AWS_REGION=us-east-1
AWS_S3_RESUME_BUCKET=applyiq-resumes-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude API key for resume match scoring and interview prep (console.anthropic.com -> Settings -> API Keys).
# Leave blank to disable the feature locally; calls will fail with a 502 until set.
ANTHROPIC_API_KEY=
# Only override these if you need a non-default model/base URL/response size.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=1024
